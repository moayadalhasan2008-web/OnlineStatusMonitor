<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Base application theme (DayNight) -->
    <style name="Theme.OnlineStatusMonitor" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/cyber_primary</item>
        <item name="colorPrimaryVariant">@color/cyber_primary</item>
        <item name="colorOnPrimary">@color/cyber_bg</item>

        <item name="colorSecondary">@color/cyber_secondary</item>
        <item name="colorSecondaryVariant">@color/cyber_secondary</item>
        <item name="colorOnSecondary">@color/cyber_text</item>

        <item name="android:statusBarColor">@color/cyber_bg</item>
        <item name="android:navigationBarColor">@color/cyber_bg</item>

        <item name="android:windowBackground">@drawable/bg_cyber_gradient</item>
        <item name="android:textColorPrimary">@color/cyber_text</item>
        <item name="android:textColorSecondary">@color/cyber_text_muted</item>
        <item name="materialCardViewStyle">@style/Widget.OnlineStatusMonitor.CyberCard</item>

        <item name="textInputStyle">@style/Widget.OnlineStatusMonitor.CyberTextInput</item>
        <item name="buttonStyle">@style/Widget.OnlineStatusMonitor.CyberButton</item>
        <item name="toolbarStyle">@style/Widget.OnlineStatusMonitor.CyberToolbar</item>

        <!-- Make ripple stand out on AMOLED -->
        <item name="colorControlHighlight">@color/cyber_primary</item>
        <item name="colorControlActivated">@color/cyber_primary</item>

        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
    </style>

    <style name="Theme.OnlineStatusMonitor.NoActionBar" parent="Theme.OnlineStatusMonitor">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <!-- Widgets -->
    <style name="Widget.OnlineStatusMonitor.CyberToolbar" parent="Widget.MaterialComponents.Toolbar.Primary">
        <item name="android:background">@color/cyber_bg</item>
        <item name="titleTextColor">@color/cyber_text</item>
        <item name="subtitleTextColor">@color/cyber_text_muted</item>
    </style>

    <style name="Widget.OnlineStatusMonitor.CyberCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/cyber_surface</item>
        <item name="cardCornerRadius">18dp</item>
        <item name="cardElevation">8dp</item>
        <item name="strokeColor">@color/cyber_primary</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.OnlineStatusMonitor.CyberButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/cyber_bg</item>
        <item name="backgroundTint">@color/cyber_primary</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">10dp</item>
        <item name="android:insetBottom">10dp</item>
    </style>

    <style name="Widget.OnlineStatusMonitor.CyberTextInput" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/cyber_primary</item>
        <item name="boxBackgroundColor">@color/cyber_surface</item>
        <item name="hintTextColor">@color/cyber_text_muted</item>
        <item name="android:textColorHint">@color/cyber_text_muted</item>
    </style>
</resources>

